generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Order {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  meat      String
  size      String
  spice     String   @default("medium")
  notes     String?
  status    String   @default("new")
  createdAt DateTime @default(now())

  @@map("orders")
}
